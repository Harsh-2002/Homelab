[Unit]
Description=Extract browsable application data directly onto the Crucial SSD
RequiresMountsFor=/EX
ConditionPathExists=/EX/linux-recovery.tar

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/extract-recovery.sh
Nice=0
IOSchedulingClass=best-effort
IOSchedulingPriority=4
TimeoutStartSec=infinity
RemainAfterExit=yes
