[Unit]
Description=Extract browsable SRVR application state from the recovery archive
After=recovery-extract.service
RequiresMountsFor=/EX
ConditionPathExists=/EX/linux-recovery.tar

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/extract-recovery-srvr.sh
Nice=0
IOSchedulingClass=best-effort
IOSchedulingPriority=4
TimeoutStartSec=infinity
RemainAfterExit=yes
