ASSET_STORE_S3_ACCESS_KEY_ID=replace-with-rustfs-access-key
ASSET_STORE_S3_SECRET_ACCESS_KEY=replace-with-rustfs-secret-key
ASSET_STORE_S3_FORCE_PATH_STYLE=true
