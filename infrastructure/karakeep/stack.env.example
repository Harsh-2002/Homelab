KARAKEEP_VERSION=release
NEXTAUTH_URL=https://pin.l3b.cc.cd
NEXTAUTH_SECRET=replace-with-a-unique-random-secret
MEILI_MASTER_KEY=replace-with-a-unique-random-secret
DISABLE_SIGNUPS=true
DB_WAL_MODE=true
OAUTH_WELLKNOWN_URL=https://auth.l3b.cc.cd/.well-known/openid-configuration
OAUTH_CLIENT_ID=replace-with-pocket-id-client-id
OAUTH_CLIENT_SECRET=replace-with-pocket-id-client-secret
OAUTH_PROVIDER_NAME=Pocket ID
OAUTH_SCOPE=openid email profile
OAUTH_ALLOW_DANGEROUS_EMAIL_ACCOUNT_LINKING=true
ASSET_STORE_S3_ENDPOINT=http://10.1.1.8:9000
ASSET_STORE_S3_REGION=us-east-1
ASSET_STORE_S3_BUCKET=karakeep
ASSET_STORE_S3_ACCESS_KEY_ID=replace-with-rustfs-access-key
ASSET_STORE_S3_SECRET_ACCESS_KEY=replace-with-rustfs-secret-key
ASSET_STORE_S3_FORCE_PATH_STYLE=true
