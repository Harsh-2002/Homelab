#!/bin/bash
ulimit -c 0
export DISPLAY="${DISPLAY:-:20}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
until [ -f "${XDG_RUNTIME_DIR}/container-env" ]; do sleep 0.5; done
. "${XDG_RUNTIME_DIR}/container-env"
cd "${HOME}" || true
/usr/local/bin/seed-desktop
until [ -S "/tmp/.X11-unix/X${DISPLAY#*:}" ]; do sleep 0.5; done
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/selkies-session-bus"
until [ -S "${XDG_RUNTIME_DIR}/selkies-session-bus" ]; do sleep 0.5; done
if [ ! -f "${HOME}/.config/.breeze-applied" ]; then
  plasma-apply-lookandfeel -a org.kde.breezedark.desktop >/dev/null 2>&1 || true
  touch "${HOME}/.config/.breeze-applied"
fi
kbuildsycoca6 --noincremental >/tmp/ksycoca.log 2>&1 || true
export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=KDE KDE_SESSION_VERSION=6 DESKTOP_SESSION=plasma XDG_MENU_PREFIX=plasma- KDE_FULL_SESSION=true
echo "[plasma] manual X11 session on ${DISPLAY}"
setsid /usr/local/bin/window-sizer >/tmp/window-sizer.log 2>&1 &
kwin_x11 >/tmp/kwin.log 2>&1 &
# restart the window manager when Selkies changes the display size, so kwin
# always knows the real screen and never places windows off-screen
(
  last=""
  while true; do
    cur=$(xdotool getdisplaygeometry 2>/dev/null || true)
    if [ -n "$last" ] && [ "$cur" != "$last" ] && [ -n "$cur" ]; then
      kwin_x11 --replace >/tmp/kwin-resize.log 2>&1 &
      sleep 1
    fi
    last="$cur"
    sleep 2
  done
) &

sleep 2
/usr/bin/qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript /usr/share/os-desktop/kwin-os-size.js >/dev/null 2>&1 || true
/usr/bin/qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.start >/dev/null 2>&1 || true
sleep 2
exec plasmashell
