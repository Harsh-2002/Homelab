      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * max by(node) (longhorn_node_storage_usage_bytes) / max by(node) (longhorn_node_storage_capacity_bytes)",
