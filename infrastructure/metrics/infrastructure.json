      }
    },
    {
      "id": 11,
      "title": "Kubernetes CPU · nodes",
      "type": "timeseries",
      "description": "Container CPU demand as a share of each Talos node's CPU capacity, measured by kubelet/cAdvisor.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * sum by(node) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container!=\"\",image!=\"\"}[5m])) / on(node) kube_node_status_capacity{resource=\"cpu\"}",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "custom": {
          "axisLabel": "CPU used",
          "axisPlacement": "auto",
          "drawStyle": "line",
          "fillOpacity": 10,
          "lineInterpolation": "smooth",
          "lineWidth": 2,
          "showPoints": "never",
          "spanNulls": false,
          "stacking": {
            "mode": "none",
            "group": "A"
          }
        }
      }
    },
