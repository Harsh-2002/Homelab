{
  "uid": "infrastructure",
  "title": "Infrastructure Overview",
  "description": "Operational health across Proxmox, Kubernetes, Longhorn, and BACKUP archives. Use Compute & Guests or Storage & Backups for drill-downs.",
  "tags": [
    "infrastructure",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Compute & Guests",
      "type": "link",
      "url": "/d/proxmox-guests/proxmox-guests",
      "icon": "server",
      "targetBlank": false
    },
    {
      "title": "Storage & Backups",
      "type": "link",
      "url": "/d/storage/storage",
      "icon": "database",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "PVE nodes online",
      "type": "stat",
      "description": "Three Proxmox hosts, deduplicated across the PVE API scrapes.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(max by(id) (pve_up{id=~\"node/.*\"}))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "title": "Guests online",
      "type": "stat",
      "description": "Running VMs and LXCs reported by Proxmox.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(max by(id) (pve_up{id=~\"(qemu|lxc)/.*\"}))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "title": "K8s nodes ready",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"} == 1)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "title": "K8s pods running",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Running\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "title": "Scrape targets down",
      "type": "stat",
      "description": "Zero means every configured scrape target is responding.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(up == bool 0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 6,
      "title": "Backups overdue",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum((time() - pve_backup_latest_timestamp_seconds{vmid!=\"\"} > bool 36 * 3600))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "description": "BACKUP guest archives older than 36 hours, including never-backed-up guests. Kubernetes VMs are intentionally excluded from this job."
    },
    {
      "id": 7,
      "title": "Proxmox CPU · nodes",
      "type": "timeseries",
      "description": "Current CPU use for px10, px20 and px30 over the selected time range.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * max by(id) (pve_cpu_usage_ratio{id=~\"node/.*\"})",
          "refId": "A",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "custom": {
          "axisLabel": "CPU used",
          "axisPlacement": "auto",
          "drawStyle": "line",
          "fillOpacity": 10,
          "lineInterpolation": "smooth",
          "lineWidth": 2,
          "showPoints": "never",
          "spanNulls": false,
          "stacking": {
            "mode": "none",
            "group": "A"
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Proxmox memory · nodes",
      "type": "timeseries",
      "description": "Memory in use as a share of installed memory on each PVE host.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * max by(id) (pve_memory_usage_bytes{id=~\"node/.*\"}) / max by(id) (pve_memory_size_bytes{id=~\"node/.*\"})",
          "refId": "A",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "custom": {
          "axisLabel": "Memory used",
          "axisPlacement": "auto",
          "drawStyle": "line",
          "fillOpacity": 10,
          "lineInterpolation": "smooth",
          "lineWidth": 2,
          "showPoints": "never",
          "spanNulls": false,
          "stacking": {
            "mode": "none",
            "group": "A"
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Proxmox storage · used capacity",
      "type": "bargauge",
      "description": "PVE datastore fill. Shared BACKUP and ISO exports appear once, from px10; the storage dashboard has mount-level details.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * max by(id) (pve_disk_usage_bytes{id=~\"storage/.*\",id!~\"storage/(px20|px30)/(BACKUP|ISO)\"}) / max by(id) (pve_disk_size_bytes{id=~\"storage/.*\",id!~\"storage/(px20|px30)/(BACKUP|ISO)\"})",
          "refId": "A",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "title": "Longhorn · disk used by node",
      "type": "bargauge",
