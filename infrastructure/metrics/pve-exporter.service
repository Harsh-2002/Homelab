[Unit]
Description=Read-only Proxmox Prometheus exporter
After=network-online.target
Wants=network-online.target

[Service]
User=pve-exporter
Group=pve-exporter
ExecStart=/opt/pve-exporter/bin/pve_exporter --config.file /etc/pve-exporter/pve.yml --web.listen-address 127.0.0.1:9221 --no-collector.config
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
