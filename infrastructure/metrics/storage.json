{
  "uid": "storage",
  "title": "Storage & Backups",
  "description": "Physical storage and backup health: Proxmox datastores, ZFS, Longhorn, guest filesystems, and the Store volumes. Views overlap; do not sum them.",
  "tags": [
    "storage",
    "backups",
    "longhorn",
    "zfs"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Infrastructure Overview",
      "type": "link",
      "url": "/d/infrastructure/infrastructure",
      "icon": "home",
      "targetBlank": false
    },
    {
      "title": "Compute & Guests",
      "type": "link",
      "url": "/d/proxmox-guests/proxmox-guests",
      "icon": "server",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 13,
      "title": "ZFS raw capacity",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(zfs_pool_size_bytes{host!=\"\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "description": "Sum of the physical ZFS pool capacities on px10, px20, and px30; this does not include the external Store disks."
    },
    {
      "id": 2,
      "title": "ZFS allocated",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(zfs_pool_allocated_bytes{host!=\"\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "description": "Physical bytes allocated across the three Proxmox ZFS hosts. Replicated guest disks consume capacity on more than one host."
    },
    {
      "id": 3,
      "title": "Longhorn · physical disk used",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(longhorn_node_storage_usage_bytes)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 14,
      "title": "Store volumes · used",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(node_filesystem_size_bytes{job=\"data-hosts\",host=\"store\",mountpoint=~\"/srv/(AV|PX|ISO)\"} - node_filesystem_avail_bytes{job=\"data-hosts\",host=\"store\",mountpoint=~\"/srv/(AV|PX|ISO)\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "description": "Used physical bytes across the AV, PX and ISO filesystems on Store; not included in ZFS totals."
    },
    {
      "id": 1,
      "title": "PX backups · used",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"data-hosts\",host=\"store\",instance=\"10.1.1.12:9100\",mountpoint=\"/srv/PX\"} / node_filesystem_size_bytes{job=\"data-hosts\",host=\"store\",instance=\"10.1.1.12:9100\",mountpoint=\"/srv/PX\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "description": "Used space on the Store PX filesystem, including any backup exports."
    },
    {
      "id": 4,
      "title": "Linux mounts · above 80%",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(100 * (1 - node_filesystem_avail_bytes{job=~\"data-hosts|linux-guests\",host!=\"\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs\",mountpoint!~\"/boot.*\"} / node_filesystem_size_bytes{job=~\"data-hosts|linux-guests\",host!=\"\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs\",mountpoint!~\"/boot.*\"}) > bool 80)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "title": "Proxmox datastores · capacity used",
      "type": "bargauge",
      "description": "Unique PVE datastore views; shared PX and ISO exports are shown once from px10.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * max by(id) (pve_disk_usage_bytes{id=~\"storage/.*\",id!~\"storage/(px20|px30)/(PX|ISO)\"}) / max by(id) (pve_disk_size_bytes{id=~\"storage/.*\",id!~\"storage/(px20|px30)/(PX|ISO)\"})",
          "refId": "A",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "ZFS pool · allocated over time",
      "type": "timeseries",
      "description": "ZFS allocation divided by pool size. Host labels identify which physical node owns the pool.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * zfs_pool_allocated_bytes{host!=\"\"} / zfs_pool_size_bytes{host!=\"\"}",
          "refId": "A",
          "legendFormat": "{{host}} · {{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "custom": {
          "axisLabel": "Pool allocated",
          "axisPlacement": "auto",
          "drawStyle": "line",
          "fillOpacity": 10,
          "lineInterpolation": "smooth",
          "lineWidth": 2,
          "showPoints": "never",
          "stacking": {
            "mode": "none",
            "group": "A"
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Linux filesystems · used capacity",
      "type": "table",
      "description": "Real filesystems and mountpoints from Debian guests and data hosts. Temporary filesystems and boot partitions are excluded.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=~\"data-hosts|linux-guests\",host!=\"\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs\",mountpoint!~\"/boot.*\"} / node_filesystem_size_bytes{job=~\"data-hosts|linux-guests\",host!=\"\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs\",mountpoint!~\"/boot.*\"})",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-text"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used %"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 70
                    },
                    {
                      "color": "red",
                      "value": 85
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true,
              "device": true,
              "fstype": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "Used %"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Largest ZFS datasets · referenced",
      "type": "table",
      "description": "Data referenced by each dataset, excluding empty volume reservations. Snapshots and replicated copies require separate accounting; compare physical zpool allocation for real disk fill.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "topk(20, zfs_dataset_referenced_bytes{host!=\"\",dataset!~\"^(data|rpool|rpool/data)$\"})",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true,
              "__name__": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "Referenced"
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "Largest data directories · daily scan",
      "type": "table",
      "description": "Largest immediate directories under the configured data roots. The scan runs daily and is a snapshot, not a live file index.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "topk(20, storage_directory_bytes)",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true,
              "__name__": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "Used"
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "Store volumes · used space",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "node_filesystem_size_bytes{job=\"data-hosts\",host=\"store\",instance=\"10.1.1.12:9100\",mountpoint=~\"/srv/(AV|PX|ISO)\"} - node_filesystem_avail_bytes{job=\"data-hosts\",host=\"store\",instance=\"10.1.1.12:9100\",mountpoint=~\"/srv/(AV|PX|ISO)\"}",
          "refId": "A",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 28,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "custom": {
          "axisLabel": "Used bytes",
          "axisPlacement": "auto",
          "drawStyle": "line",
          "fillOpacity": 8,
          "lineInterpolation": "smooth",
          "lineWidth": 2,
          "showPoints": "never",
          "stacking": {
            "mode": "none",
            "group": "A"
          }
        }
      },
      "description": "Used bytes on AV, PX, and ISO. These are separate partitions, not a single pool."
    },
    {
      "id": 11,
      "title": "Longhorn · disk use by node",
      "type": "bargauge",
      "description": "Physical Longhorn disk usage against raw capacity per node. Replicas consume additional physical space.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * max by(node) (longhorn_node_storage_usage_bytes) / max by(node) (longhorn_node_storage_capacity_bytes)",
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 12,
      "title": "Backup age · protected guests",
      "type": "bargauge",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "(time() - pve_backup_latest_timestamp_seconds{vmid!=\"\"}) / 3600",
          "refId": "A",
          "legendFormat": "VM {{vmid}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 24
              },
              {
                "color": "red",
                "value": 36
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Hours since the newest completed PX backup archive for each protected guest. Red means older than 36 hours."
    }
  ]
}
