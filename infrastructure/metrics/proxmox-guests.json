{
  "uid": "proxmox-guests",
  "title": "Proxmox Guests & Mounts",
  "tags": ["proxmox", "guests", "storage"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "title": "Guest CPU utilization", "type": "bargauge", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "victoria"}, "targets": [{"expr": "max by (id) (pve_cpu_usage_ratio{id=~\"(qemu|lxc)/.*\"})", "refId": "A", "legendFormat": "{{id}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true}},
    {"id": 2, "title": "Guest memory used", "type": "bargauge", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "victoria"}, "targets": [{"expr": "max by (id) (pve_memory_usage_bytes{id=~\"(qemu|lxc)/.*\"})", "refId": "A", "legendFormat": "{{id}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true}},
    {"id": 3, "title": "Guest disk allocated", "type": "bargauge", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9}, "datasource": {"type": "prometheus", "uid": "victoria"}, "targets": [{"expr": "max by (id) (pve_disk_size_bytes{id=~\"(qemu|lxc)/.*\"})", "refId": "A", "legendFormat": "{{id}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true}},
    {"id": 4, "title": "Guest disk used (Proxmox reported)", "type": "bargauge", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9}, "datasource": {"type": "prometheus", "uid": "victoria"}, "targets": [{"expr": "max by (id) (pve_disk_usage_bytes{id=~\"(qemu|lxc)/.*\"})", "refId": "A", "legendFormat": "{{id}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true}},
    {"id": 5, "title": "Guest mount used", "type": "bargauge", "gridPos": {"h": 12, "w": 24, "x": 0, "y": 18}, "datasource": {"type": "prometheus", "uid": "victoria"}, "targets": [{"expr": "topk(40, node_filesystem_size_bytes{job=~\"data-hosts|linux-guests\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs\"} - node_filesystem_avail_bytes{job=~\"data-hosts|linux-guests\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs\"})", "refId": "A", "legendFormat": "{{instance}} {{mountpoint}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true}},
    {"id": 6, "title": "Guest mounts over 80% full", "type": "table", "gridPos": {"h": 10, "w": 12, "x": 0, "y": 30}, "datasource": {"type": "prometheus", "uid": "victoria"}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{job=~\"data-hosts|linux-guests\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs\"} / node_filesystem_size_bytes{job=~\"data-hosts|linux-guests\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs\"}) > 80", "refId": "A", "instant": true, "format": "table"}], "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}},
    {"id": 7, "title": "Offline Proxmox guests and nodes", "type": "table", "gridPos": {"h": 10, "w": 12, "x": 12, "y": 30}, "datasource": {"type": "prometheus", "uid": "victoria"}, "targets": [{"expr": "max by (id) (pve_up{id=~\"(qemu|lxc|node)/.*\"}) == 0", "refId": "A", "instant": true, "format": "table"}], "fieldConfig": {"defaults": {}, "overrides": []}},
    {"id": 8, "title": "Failed replication syncs", "type": "table", "gridPos": {"h": 10, "w": 12, "x": 0, "y": 40}, "datasource": {"type": "prometheus", "uid": "victoria"}, "targets": [{"expr": "max by (id) (pve_replication_failed_syncs) > 0", "refId": "A", "instant": true, "format": "table"}], "fieldConfig": {"defaults": {}, "overrides": []}},
    {"id": 9, "title": "Guests without backup coverage", "type": "stat", "gridPos": {"h": 5, "w": 12, "x": 12, "y": 40}, "datasource": {"type": "prometheus", "uid": "victoria"}, "targets": [{"expr": "max(pve_not_backed_up_total)", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"id": 10, "title": "PBS datastore used", "type": "stat", "gridPos": {"h": 5, "w": 12, "x": 12, "y": 45}, "datasource": {"type": "prometheus", "uid": "victoria"}, "targets": [{"expr": "pbs_datastore_size_bytes{datastore=\"external\"} - pbs_datastore_available_bytes{datastore=\"external\"}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},
    {"id": 11, "title": "PBS backup jobs in 24h", "type": "bargauge", "gridPos": {"h": 5, "w": 24, "x": 0, "y": 50}, "datasource": {"type": "prometheus", "uid": "victoria"}, "targets": [{"expr": "pbs_backup_tasks_24h", "refId": "A", "legendFormat": "{{result}}"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true}}
  ]
}
