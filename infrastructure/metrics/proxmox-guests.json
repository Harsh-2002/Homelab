{
  "uid": "proxmox-guests",
  "title": "Compute & Guests",
  "description": "Drill into Proxmox guests, in-guest Linux mounts, replication, and Kubernetes workload demand.",
  "tags": [
    "proxmox",
    "kubernetes",
    "compute"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Infrastructure Overview",
      "type": "link",
      "url": "/d/infrastructure/infrastructure",
      "icon": "home",
      "targetBlank": false
    },
    {
      "title": "Storage & Backups",
      "type": "link",
      "url": "/d/storage/storage",
      "icon": "database",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Guests online",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(max by(id) (pve_up{id=~\"(qemu|lxc)/.*\"}))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "title": "Guests above 80% CPU",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(max by(id) (pve_cpu_usage_ratio{id=~\"(qemu|lxc)/.*\"} > bool 0.8))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "title": "Linux mounts above 80%",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(100 * (1 - node_filesystem_avail_bytes{job=~\"data-hosts|linux-guests\",host!=\"\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs\",mountpoint!~\"/boot.*\"} / node_filesystem_size_bytes{job=~\"data-hosts|linux-guests\",host!=\"\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs\",mountpoint!~\"/boot.*\"}) > bool 80)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "title": "Failed replication jobs",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "sum(max by(id) (pve_replication_failed_syncs))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "title": "Guest CPU · trend",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * max by(id) (pve_cpu_usage_ratio{id=~\"(qemu|lxc)/.*\"}) * on(id) group_left(name,node,type) max by(id,name,node,type) (pve_guest_info{id=~\"(qemu|lxc)/.*\"})",
          "refId": "A",
          "legendFormat": "{{name}} · {{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "custom": {
          "axisLabel": "CPU",
          "axisPlacement": "auto",
          "drawStyle": "line",
          "fillOpacity": 8,
          "lineInterpolation": "smooth",
          "lineWidth": 2,
          "showPoints": "never",
          "spanNulls": false,
          "stacking": {
            "mode": "none",
            "group": "A"
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Guest memory · utilization",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * max by(id) (pve_memory_usage_bytes{id=~\"(qemu|lxc)/.*\"}) / max by(id) (pve_memory_size_bytes{id=~\"(qemu|lxc)/.*\"}) * on(id) group_left(name,node,type) max by(id,name,node,type) (pve_guest_info{id=~\"(qemu|lxc)/.*\"})",
          "refId": "A",
          "legendFormat": "{{name}} · {{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "custom": {
          "axisLabel": "Memory",
          "axisPlacement": "auto",
          "drawStyle": "line",
          "fillOpacity": 8,
          "lineInterpolation": "smooth",
          "lineWidth": 2,
          "showPoints": "never",
          "spanNulls": false,
          "stacking": {
            "mode": "none",
            "group": "A"
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Guest inventory · live state",
      "type": "table",
      "description": "Name and placement come from Proxmox guest metadata; state is the PVE guest availability signal.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "max by(id) (pve_up{id=~\"(qemu|lxc)/.*\"}) * on(id) group_left(name,node,type) max by(id,name,node,type) (pve_guest_info{id=~\"(qemu|lxc)/.*\"})",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Offline",
                        "color": "red"
                      },
                      "1": {
                        "text": "Online",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "State"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Linux filesystem utilization",
      "type": "table",
      "description": "Filesystem fill from Node Exporter. Pseudo filesystems and EFI boot mounts are omitted.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=~\"data-hosts|linux-guests\",host!=\"\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs\",mountpoint!~\"/boot.*\"} / node_filesystem_size_bytes{job=~\"data-hosts|linux-guests\",host!=\"\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs\",mountpoint!~\"/boot.*\"})",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "gauge",
              "mode": "gradient"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used %"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 70
                    },
                    {
                      "color": "red",
                      "value": 85
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true,
              "device": true,
              "fstype": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "Used %"
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "Kubernetes CPU · namespaces",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "topk(8, sum by(namespace) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container!=\"\",image!=\"\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "custom": {
          "drawStyle": "line",
          "lineWidth": 2,
          "fillOpacity": 8,
          "showPoints": "never",
          "stacking": {
            "mode": "none",
            "group": "A"
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Kubernetes memory · namespaces",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "expr": "topk(8, sum by(namespace) (container_memory_working_set_bytes{job=\"cadvisor\",container!=\"\",image!=\"\"}))",
          "refId": "A",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "custom": {
          "drawStyle": "line",
          "lineWidth": 2,
          "fillOpacity": 8,
          "showPoints": "never",
          "stacking": {
            "mode": "none",
            "group": "A"
          }
        }
      }
    }
  ]
}
