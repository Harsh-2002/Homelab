# Runtime configuration for /etc/default/rustfs. Keep the real file mode 0600.
RUSTFS_VOLUMES=/data/rustfs
RUSTFS_ROOT_USER=replace-with-break-glass-access-key
RUSTFS_ROOT_PASSWORD=replace-with-long-break-glass-secret
RUSTFS_ADDRESS=10.1.1.8:9000
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_CONSOLE_ADDRESS=10.1.1.8:9001
RUSTFS_REGION=us-east-1
RUSTFS_BUFFER_PROFILE=GeneralPurpose
RUSTFS_HEALTH_ENDPOINT_ENABLE=true
RUSTFS_TRUST_SYSTEM_CA=true
RUSTFS_BROWSER_REDIRECT_URL=https://rustfs.l3b.cc.cd
RUSTFS_OUTBOUND_ALLOW_ORIGINS=https://auth.l3b.cc.cd
RUSTFS_IDENTITY_OPENID_ENABLE=true
RUSTFS_IDENTITY_OPENID_CONFIG_URL=https://auth.l3b.cc.cd/.well-known/openid-configuration
RUSTFS_IDENTITY_OPENID_CLIENT_ID=s3
RUSTFS_IDENTITY_OPENID_CLIENT_SECRET=replace-with-pocket-id-client-secret
RUSTFS_IDENTITY_OPENID_SCOPES=openid,profile,email,groups
RUSTFS_IDENTITY_OPENID_REDIRECT_URI=https://rustfs.l3b.cc.cd/rustfs/admin/v3/oidc/callback/default
RUSTFS_IDENTITY_OPENID_REDIRECT_URI_DYNAMIC=false
RUSTFS_IDENTITY_OPENID_DISPLAY_NAME=Pocket ID
RUSTFS_IDENTITY_OPENID_GROUPS_CLAIM=groups
RUSTFS_IDENTITY_OPENID_EMAIL_CLAIM=email
RUSTFS_IDENTITY_OPENID_USERNAME_CLAIM=preferred_username
