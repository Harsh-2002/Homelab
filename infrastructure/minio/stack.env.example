# Store the four real values in Komodo's MinIO Stack environment, not in Git.
# Use unique, random values; root credentials are for administration only.
MINIO_ROOT_USER=replace-with-random-root-access-key
MINIO_ROOT_PASSWORD=replace-with-long-random-root-secret
# These must remain stable across restarts for the image's bundled console.
CONSOLE_PBKDF_PASSPHRASE=replace-with-32-or-more-random-characters
CONSOLE_PBKDF_SALT=replace-with-48-or-more-random-characters
