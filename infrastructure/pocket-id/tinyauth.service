[Unit]
Description=Tinyauth forward authentication service
After=network-online.target pocket-id.service
Wants=network-online.target

[Service]
Type=simple
User=tinyauth
Group=tinyauth
EnvironmentFile=/etc/tinyauth/tinyauth.env
WorkingDirectory=/var/lib/tinyauth
ExecStart=/usr/local/bin/tinyauth
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tinyauth
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
